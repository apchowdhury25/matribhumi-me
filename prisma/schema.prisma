generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local default is SQLite so the site runs without Docker.
  // Production: set provider = "postgresql" and a Postgres DATABASE_URL.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  SALES
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  COMMERCIAL
  HOSPITALITY
  MIXED_USE
  PLOT
}

enum PropertyStatus {
  UPCOMING
  LAUNCHED
  UNDER_CONSTRUCTION
  READY
  SOLD_OUT
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  HOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING_SCHEDULED
  NEGOTIATION
  CONVERTED
  CLOSED
}

enum InquiryType {
  GENERAL
  SALES
  PARTNERSHIP
  MEDIA
  CAREER
}

enum DeveloperStatus {
  PROSPECT
  ACTIVE
  PAUSED
  ENDED
}

enum PartnershipStatus {
  PROSPECT
  UNDER_REVIEW
  ACTIVE
  PAUSED
  ENDED
}

enum LeadPurpose {
  PRIMARY_RESIDENCE
  SECOND_HOME
  RELOCATION
  INVESTMENT
  OTHER
}

enum LeadQualification {
  UNQUALIFIED
  QUALIFYING
  QUALIFIED
  DISQUALIFIED
}

enum LeadSource {
  WEBSITE
  ADVISORY
  WAITLIST
  BROCHURE
  REFERRAL
  DIRECT
  OTHER
}

enum DealStage {
  BUYER_LEAD
  CONTACTED
  QUALIFICATION
  QUALIFIED
  SHORTLISTED
  DEVELOPER_INTRODUCTION
  VIEWING
  PROPERTY_SELECTED
  RESERVATION
  CONTRACT
  COMPLETION
  CLOSED
  LOST
  WITHDRAWN
}

enum DealStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum ViewingType {
  IN_PERSON
  VIRTUAL
  SITE_VISIT
}

enum ViewingStatus {
  NEW
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum CompensationType {
  PERCENTAGE
  FIXED
  HYBRID
  OTHER
}

enum CompensationAgreementStatus {
  DRAFT
  AGREED
  ACTIVE
  EXPIRED
}

enum CompensationPaymentStatus {
  NOT_DUE
  EXPECTED
  INVOICED
  PAID
  WRITTEN_OFF
}

enum IntroductionMethod {
  EMAIL
  PHONE
  WHATSAPP
  MEETING
  OTHER
}

enum IntroductionStatus {
  PLANNED
  SENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

enum ArticleCategory {
  NEWS
  PROJECT_UPDATES
  ARCHITECTURE
  DESIGN
  SUSTAINABILITY
  MARKET_INSIGHTS
  LIFESTYLE
}

enum DevelopmentCategory {
  RESIDENTIAL
  VILLAS
  COMMERCIAL
  HOSPITALITY
  MIXED_USE
  WATERFRONT
  COMMUNITIES
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String
  passwordHash     String
  role             UserRole         @default(EDITOR)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  articles         NewsArticle[]
  favorites        Favorite[]
  assignedLeads     Lead[]           @relation("LeadAssignee")
  assignedDeals     Deal[]           @relation("DealAdvisor")
  assignedViewings  ViewingRequest[] @relation("ViewingAdvisor")
  assignedFollowUps FollowUp[]       @relation("FollowUpAdvisor")
}

model Developer {
  id                  String                  @id @default(cuid())
  name                String
  slug                String                  @unique
  description         String
  publicDescription   String                  @default("")
  logoUrl             String?
  website             String?
  country             String                  @default("Bangladesh")
  cities              Json?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  status              DeveloperStatus         @default(PROSPECT)
  published           Boolean                 @default(false)
  verified            Boolean                 @default(false)
  featured            Boolean                 @default(false)
  relationshipNotes   String?
  internalNotes       String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  properties          Property[]
  developments        Development[]
  partnerships        DeveloperPartnership[]
  referredLeads       Lead[]
  deals               Deal[]
  viewings            ViewingRequest[]
  shortlistItems      LeadShortlistItem[]
  introductions       DeveloperIntroduction[]
  followUps           FollowUp[]
}

model DeveloperPartnership {
  id                   String                   @id @default(cuid())
  developerId          String
  developer            Developer                @relation(fields: [developerId], references: [id], onDelete: Cascade)
  relationshipStatus   PartnershipStatus        @default(PROSPECT)
  startDate            DateTime?
  endDate              DateTime?
  markets              Json
  agreementReference   String?
  internalNotes        String?
  active               Boolean                  @default(true)
  publicVisibility     Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  compensations        DeveloperCompensation[]

  @@index([developerId])
  @@index([active])
  @@index([relationshipStatus])
}

model DeveloperCompensation {
  id                   String                       @id @default(cuid())
  partnershipId        String
  partnership          DeveloperPartnership         @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  compensationType     CompensationType             @default(PERCENTAGE)
  agreementStatus      CompensationAgreementStatus  @default(DRAFT)
  agreementReference   String?
  percentage           Decimal?
  fixedAmount          Decimal?
  currency             String                       @default("USD")
  paymentStatus        CompensationPaymentStatus    @default(NOT_DUE)
  paymentDate          DateTime?
  transactionReference String?
  internalNotes        String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([partnershipId])
}

model Location {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  city             String
  country          String
  region           String?
  description      String
  overview         String
  lifestyle        String
  connectivity     String
  opportunities    String
  heroImage        String
  latitude         Float
  longitude        Float
  featured         Boolean        @default(false)
  attractions      Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  developments     Development[]
  properties       Property[]
}

model Development {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  tagline      String
  description  String
  architecture String
  lifestyle    String
  locationNote String
  heroImage    String
  category     DevelopmentCategory
  propertyType PropertyType
  status       PropertyStatus
  completion   String
  startingPrice Decimal
  currency     String               @default("USD")
  stats        Json
  featured     Boolean              @default(false)
  signature    Boolean              @default(false)
  published    Boolean              @default(true)
  matribhumiOwned Boolean           @default(false)
  latitude     Float
  longitude    Float
  locationId   String
  location     Location             @relation(fields: [locationId], references: [id])
  developerId  String
  developer    Developer            @relation(fields: [developerId], references: [id])
  properties   Property[]
  leads        Lead[]
  deals        Deal[]
  shortlistItems LeadShortlistItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([locationId])
  @@index([status])
  @@index([category])
  @@index([featured])
}

model Property {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String
  type           PropertyType
  status         PropertyStatus
  completionDate DateTime?
  startingPrice  Decimal
  currency       String            @default("USD")
  bedroomsMin    Int
  bedroomsMax    Int
  bathroomsMin   Int
  bathroomsMax   Int
  areaMin        Int
  areaMax        Int
  areaUnit       String            @default("sqft")
  floors         Int?
  totalUnits     Int?
  heroImage      String
  videoUrl       String?
  brochureUrl    String?
  latitude       Float
  longitude      Float
  featured       Boolean           @default(false)
  published      Boolean           @default(true)
  matribhumiOwned Boolean          @default(false)
  whyThisProperty String?
  lifestyle      String?
  developmentId  String
  development    Development       @relation(fields: [developmentId], references: [id])
  locationId     String
  location       Location          @relation(fields: [locationId], references: [id])
  developerId    String
  developer      Developer         @relation(fields: [developerId], references: [id])
  images         PropertyImage[]
  units          Unit[]
  amenities      PropertyAmenity[]
  floorPlans     FloorPlan[]
  nearbyPlaces   NearbyPlace[]
  leads          Lead[]
  viewings       ViewingRequest[]
  favorites      Favorite[]
  deals          Deal[]
  shortlistItems LeadShortlistItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([locationId])
  @@index([type])
  @@index([status])
  @@index([startingPrice])
  @@index([published])
  @@index([featured])
  @@index([bedroomsMin])
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  slug       String            @unique
  icon       String
  category   String
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  alt        String
  caption    String?
  sortOrder  Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model FloorPlan {
  id         String   @id @default(cuid())
  name       String
  type       String
  imageUrl   String
  pdfUrl     String?
  area       Int
  bedrooms   Int
  bathrooms  Int
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Unit {
  id         String     @id @default(cuid())
  name       String
  type       String
  bedrooms   Int
  bathrooms  Int
  area       Int
  price      Decimal
  status     UnitStatus @default(AVAILABLE)
  floor      Int?
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@index([propertyId])
  @@index([status])
}

model NearbyPlace {
  id         String   @id @default(cuid())
  name       String
  category   String
  distance   String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Lead {
  id                  String            @id @default(cuid())
  name                String
  email               String
  phone               String
  country             String
  buyerCity           String?
  nationality         String?
  residenceCountry    String?
  preferredMarket     String?
  preferredCity       String?
  propertyType        PropertyType?
  budget              String?
  budgetMin           Decimal?
  budgetMax           Decimal?
  currency            String            @default("USD")
  bedrooms            Int?
  purpose             LeadPurpose?
  timeline            String?
  financingStatus     String?
  contactMethod       ContactMethod     @default(EMAIL)
  source              LeadSource        @default(WEBSITE)
  message             String
  inquiryType         InquiryType       @default(SALES)
  status              LeadStatus        @default(NEW)
  qualificationStatus LeadQualification @default(UNQUALIFIED)
  propertyId          String?
  property            Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  developmentId       String?
  development         Development?      @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  developerId         String?
  developer           Developer?        @relation(fields: [developerId], references: [id], onDelete: SetNull)
  assignedStaffId     String?
  assignedStaff       User?             @relation("LeadAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  notes               String?
  nextFollowUpAt      DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deals               Deal[]
  viewings            ViewingRequest[]
  shortlistItems      LeadShortlistItem[]
  introductions       DeveloperIntroduction[]
  followUps           FollowUp[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([propertyId])
  @@index([developerId])
  @@index([assignedStaffId])
  @@index([qualificationStatus])
}

model ViewingRequest {
  id                  String         @id @default(cuid())
  name                String
  email               String
  phone               String
  preferredDate       DateTime
  preferredTime       String
  viewingType         ViewingType    @default(IN_PERSON)
  locationNote        String?
  contactMethod       ContactMethod  @default(EMAIL)
  message             String?
  notes               String?
  status              ViewingStatus  @default(NEW)
  developerConfirmed  Boolean        @default(false)
  propertyId          String
  property            Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  leadId              String?
  lead                Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  developerId         String?
  developer           Developer?     @relation(fields: [developerId], references: [id], onDelete: SetNull)
  assignedAdvisorId   String?
  assignedAdvisor     User?          @relation("ViewingAdvisor", fields: [assignedAdvisorId], references: [id], onDelete: SetNull)
  dealId              String?
  deal                Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([propertyId])
  @@index([status])
  @@index([leadId])
  @@index([developerId])
  @@index([dealId])
}

model Deal {
  id                    String             @id @default(cuid())
  leadId                String
  lead                  Lead               @relation(fields: [leadId], references: [id], onDelete: Restrict)
  developerId           String?
  developer             Developer?         @relation(fields: [developerId], references: [id], onDelete: SetNull)
  developmentId         String?
  development           Development?       @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  propertyId            String?
  property              Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId                String?
  unit                  Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assignedAdvisorId     String?
  assignedAdvisor       User?              @relation("DealAdvisor", fields: [assignedAdvisorId], references: [id], onDelete: SetNull)
  stage                 DealStage          @default(BUYER_LEAD)
  status                DealStatus         @default(OPEN)
  estimatedValue        Decimal?
  currency              String             @default("USD")
  developerReferralAt   DateTime?
  viewingAt             DateTime?
  reservationAt         DateTime?
  contractAt            DateTime?
  completionAt          DateTime?
  internalNotes         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  viewings              ViewingRequest[]
  compensation          DealCompensation?
  introductions         DeveloperIntroduction[]
  followUps             FollowUp[]

  @@index([leadId])
  @@index([developerId])
  @@index([propertyId])
  @@index([stage])
  @@index([status])
  @@index([assignedAdvisorId])
}

model DealCompensation {
  id                   String                    @id @default(cuid())
  dealId               String                    @unique
  deal                 Deal                      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  compensationType     CompensationType          @default(PERCENTAGE)
  agreementStatus      CompensationAgreementStatus @default(DRAFT)
  agreementReference   String?
  percentage           Decimal?
  expectedAmount       Decimal?
  currency             String                    @default("USD")
  paymentStatus        CompensationPaymentStatus @default(NOT_DUE)
  paymentDate          DateTime?
  transactionReference String?
  internalNotes        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
}

model LeadShortlistItem {
  id                     String       @id @default(cuid())
  leadId                 String
  lead                   Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId             String
  property               Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  developerId            String?
  developer              Developer?   @relation(fields: [developerId], references: [id], onDelete: SetNull)
  developmentId          String?
  development            Development? @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  estimatedPrice         Decimal?
  currency               String       @default("USD")
  locationNote           String?
  keyFeatures            String?
  notes                  String?
  advisorRecommendation  String?
  sortOrder              Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([leadId, propertyId])
  @@index([leadId])
  @@index([propertyId])
}

model DeveloperIntroduction {
  id            String               @id @default(cuid())
  leadId        String
  lead          Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId        String?
  deal          Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  developerId   String
  developer     Developer            @relation(fields: [developerId], references: [id], onDelete: Restrict)
  introducedAt  DateTime             @default(now())
  contactPerson String?
  method        IntroductionMethod   @default(EMAIL)
  notes         String?
  status        IntroductionStatus   @default(SENT)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([leadId])
  @@index([dealId])
  @@index([developerId])
  @@index([status])
}

model FollowUp {
  id                 String     @id @default(cuid())
  leadId             String?
  lead               Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId             String?
  deal               Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  developerId        String?
  developer          Developer? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  assignedAdvisorId  String?
  assignedAdvisor    User?      @relation("FollowUpAdvisor", fields: [assignedAdvisorId], references: [id], onDelete: SetNull)
  dueAt              DateTime
  task               String
  note               String?
  completed          Boolean    @default(false)
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([dueAt])
  @@index([completed])
  @@index([leadId])
  @@index([dealId])
  @@index([developerId])
  @@index([assignedAdvisorId])
}

model NewsArticle {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  excerpt     String
  body        String
  coverImage  String
  category    ArticleCategory
  authorId    String
  author      User            @relation(fields: [authorId], references: [id])
  readingTime Int
  published   Boolean         @default(true)
  publishedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([publishedAt])
  @@index([published])
}

model Job {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  department   String
  location     String
  type         String
  description  String
  requirements String
  published    Boolean          @default(true)
  applications JobApplication[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([department])
  @@index([published])
}

model JobApplication {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  resumeUrl   String
  coverLetter String
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  createdAt   DateTime @default(now())

  @@index([jobId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  sessionId  String?
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([sessionId])
  @@index([propertyId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  key       String   @unique
  filename  String
  mimeType  String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
}
